ting to Google and Yahoo’s mandatory sender requirements, universal DMARC enforcement, and BIMI adoption rates now exceeding 31% among Fortune 500 senders."}],["$","div",null,{"className":"flex flex-wrap gap-1.5 mb-4","children":[["$","span","email marketing",{"className":"text-xs text-[#80504A] bg-[#1A0A0A] px-2 py-0.5 rounded-md","children":"email marketing"}],["$","span","email benchmarks",{"className":"text-xs text-[#80504A] bg-[#1A0A0A] px-2 py-0.5 rounded-md","children":"email benchmarks"}],["$","span","open rates",{"className":"text-xs text-[#80504A] bg-[#1A0A0A] px-2 py-0.5 rounded-md","children":"open rates"}]]}],["$","div",null,{"className":"flex items-center justify-between pt-4 border-t border-[#5F1E1E]","children":[["$","div",null,{"className":"flex items-center gap-2 text-xs text-[#80504A]","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-user w-3.5 h-3.5","children":[["$","path","975kel",{"d":"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"}],["$","circle","17ys0d",{"cx":"12","cy":"7","r":"4"}],"$undefined"]}],"Amy Foster",["$","span",null,{"className":"mx-1","children":"·"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-calendar w-3.5 h-3.5","children":[["$","path","1cmpym",{"d":"M8 2v4"}],["$","path","4m81vk",{"d":"M16 2v4"}],["$","rect","1hopcy",{"width":"18","height":"18","x":"3","y":"4","rx":"2"}],["$","path","8toen8",{"d":"M3 10h18"}],"$undefined"]}],"May 26, 2026"]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeL