":"px-4 py-3 text-[#BE8A83]","children":"Keep it under 100 characters. Try: \"Expires tonight →\" vs. \"Here's what's inside...\""}]]}],["$","tr","2",{"className":"border-b border-[#5F1E1E]/50 hover:bg-[#401616]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#BE8A83]","children":"**CTA Button Copy**"}],["$","td","1",{"className":"px-4 py-3 text-[#BE8A83]","children":"+21% CTR (HubSpot, 2024)"}],["$","td","2",{"className":"px-4 py-3 text-[#BE8A83]","children":"Direct language reduces cognitive load"}],["$","td","3",{"className":"px-4 py-3 text-[#BE8A83]","children":"Avoid \"Submit\" -- use action-oriented, benefit-driven text: \"Get My Free Template\" > \"Download Now\"."}]]}],["$","tr","3",{"className":"border-b border-[#5F1E1E]/50 hover:bg-[#401616]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#BE8A83]","children":"**Email Layout (Single vs. Multi-column)**"}],["$","td","1",{"className":"px-4 py-3 text-[#BE8A83]","children":"+14% mobile CTR (Litmus, 2023)"}],["$","td","2",{"className":"px-4 py-3 text-[#BE8A83]","children":"Mobile accounts for 48% of email opens (Litmus) -- clutter kills scannability"}],["$","td","3",{"className":"px-4 py-3 text-[#BE8A83]","children":"For B2B newsletters: Test a single-column, top-aligned CTA vs. a two-column layout with image + text."}]]}],["$","tr","4",{"className":"border-b border-[#5F1E1E]/50 hover:bg-[#401616]/50 transition-colors","children":[["$","td","0",{"className":"px-4 py-3 text-[#BE8A83]","children":"**Sender Name**"}],["$","td","1",{"className":"px-4 py-3 text-[#BE8A83]","children":"+9% open rate (Yes Lifecycle Marketing)"}],["$","td","2",{"className":"px-4 py-3 text-[#BE8A83]","children":"Trust and recognition drive opens"}],["$","td","3",{"className":"px-4 py-3 text-[#BE8A83]","children":"Test \"Alex Morgan, Product Lead\" vs. \"Acme Inc.\" -- *especially* for nurture sequences."}]]}]]}]]}]}]
