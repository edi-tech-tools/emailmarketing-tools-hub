45:["$","h2","93",{"className":"text-xl md:text-2xl font-bold text-[#FEF2F0] mt-10 mb-4 tracking-tight","children":"10. Audit & Update Your List Hygiene *Monthly*"}]
46:["$","p","94",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Hard truth:"}]," Even healthy lists decay at ",["$","strong","3",{"className":"font-bold text-[#FEF2F0]","children":"2.1% per month"}]," (Return Path). Without monthly cleaning, your unknown user rate climbs silently--killing deliverability."]}]
47:["$","p","96",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["✅ ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Actionable step:"}]," Run these checks every 30 days:"]}]
48:["$","p","97",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["- Remove hard bounces (immediately)"]}]
49:["$","p","98",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["- Suppress role-based emails (`admin@`, `info@`)"]}]
