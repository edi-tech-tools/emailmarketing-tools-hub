3f:["$","p","82",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["✅ ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Actionable step:"}]," Set up automated alerts in ",["$","strong","3",{"className":"font-bold text-[#FEF2F0]","children":"250ok"}]," or ",["$","strong","5",{"className":"font-bold text-[#FEF2F0]","children":"Google Postmaster Tools"}]," for any metric crossing thresholds. Investigate complaints *within 2 hours*."]}]
