42:["$","p","87",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Brands using dedicated domains (`email.yourbrand.com`) enjoy ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"92% average inbox placement"}],", versus 76% for shared domains (SparkPost 2026 Deliverability Index). Why? Full control over DNS, reputation isolation, and BIMI eligibility."]}]
43:["$","p","89",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["✅ ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Actionable step:"}]," Migrate *all* email streams (transactional + marketing) to subdomains under your root domain. Never use `yourbrand.com` directly--always `email.yourbrand.com` or `news.yourbrand.com`."]}]
