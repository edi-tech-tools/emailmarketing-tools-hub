22:["$","h2","39",{"className":"text-xl md:text-2xl font-bold text-[#FEF2F0] mt-10 mb-4 tracking-tight","children":"4. Warm Up New IPs *and* Domains Gradually"}]
23:["$","p","40",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Reality check:"}]," Sending 50k emails on day one from a new IP? You'll trigger automatic throttling from Microsoft 365--and likely land in spam. ISPs now rate-limit *new domains* even more aggressively than IPs."]}]
24:["$","p","42",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["✅ ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Actionable step:"}]," Follow the ",["$","strong","3",{"className":"font-bold text-[#FEF2F0]","children":"7-day ramp-up curve"}],":"]}]
25:["$","p","43",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["- Days 1-2: 500 emails/day (to highly engaged segments only)"]}]
26:["$","p","44",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["- Days 3-4: 2,500/day"]}]
27:["$","p","45",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["- Days 5-6: 10,000/day"]}]
28:["$","p","46",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["- Day 7+: Scale to full volume *only after* inbox placement ≥95% (measured via GlockApps or 250ok)."]}]
