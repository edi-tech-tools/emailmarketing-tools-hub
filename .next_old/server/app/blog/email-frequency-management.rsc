1a:["$","p","28",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["✅ *Actionable tip:* Audit your sign-up forms. If your CTA says *\"Get weekly marketing tips,\"* don't suddenly shift to 5 emails/week -- unless you've re-confirmed consent."]}]
1b:["$","h3","30",{"className":"text-lg font-bold text-[#FEF2F0] mt-8 mb-3","children":"2. **Engagement Tiering**"}]
1c:["$","p","31",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Not all subscribers are equal. High-engagement users (opened 4+ of last 5 emails) tolerate -- even *expect* -- more contact. Low-engagement users (no opens in 90 days) need re-engagement, not bombardment."]}]
