1e:["$","p","34",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Set up behavioral scoring that assigns points for key actions: website visits, content downloads, email clicks, and demo requests. When a lead crosses a threshold, automatically notify the sales team. Companies using lead scoring see 77% higher marketing ROI than those without."]}]
1f:["$","h3","36",{"className":"text-lg font-bold text-[#FEF2F0] mt-8 mb-3","children":"Drip Campaigns for Nurturing"}]
20:["$","p","37",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Design 5-7 email sequences that educate rather than sell. Top-of-funnel drips share industry insights and best practices. Mid-funnel emails compare solutions and share case studies. Bottom-funnel emails offer demos and free trials. Each email should have a single, clear call-to-action."]}]
21:["$","h3","39",{"className":"text-lg font-bold text-[#FEF2F0] mt-8 mb-3","children":"Lifecycle Trigger Emails"}]
22:["$","p","40",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Beyond basic drip campaigns, implement triggered emails based on user behavior: welcome series for new subscribers, re-engagement campaigns for inactive contacts, post-purchase onboarding sequences, and renewal reminders for existing customers. Triggered emails generate 4x more revenue than broadcast emails."]}]
23:["$","h3","42",{"className":"text-lg font-bold text-[#FEF2F0] mt-8 mb-3","children":"Personalization at Scale"}]
24:["$","p","43",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Use dynamic content blocks that swap based on contact attributes: industry, company size, job role, and past behavior. Personalized emails deliver 6x higher transaction rates. Advanced platforms like Marketo and HubSpot allow dynamic content within the same email."]}]
25:["$","h2","45",{"className":"text-xl md:text-2xl font-bold text-[#FEF2F0] mt-10 mb-4 tracking-tight","children":"Measuring Success"}]
26:["$","p","47",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Track these KPIs: open rate (B2B benchmark: 21-25%), click-through rate (2-5%), conversion rate (lead to opportunity), unsubscribe rate (under 0.5%), and revenue attributed to email campaigns. Use UTM parameters and marketing attribution to connect email activity to pipeline generation."]}]
27:["$","h2","49",{"className":"text-xl md:text-2xl font-bold text-[#FEF2F0] mt-10 mb-4 tracking-tight","children":"Getting Started"}]
28:["$","p","51",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["Start with one lifecycle workflow (welcome series is the highest-impact), measure results for 30 days, then add a lead nurturing sequence. Most B2B organizations see 20-30% of their total pipeline generated through automated email campaigns within 3-4 months."]}]
