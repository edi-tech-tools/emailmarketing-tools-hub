3f:["$","p","78",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["1. ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Code validation"}],": [W3C Markup Validator](https://validator.w3.org/) + [Email on Acid's Code Scanner](https://www.emailonacid.com/code-scanner) (catches deprecated attributes like `align=\"center\"`)"]}]
40:["$","p","79",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["2. ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Client rendering"}],": Test across *at least* 12 clients -- including Outlook 2016/2019/365 (Windows), Apple Mail (iOS 17/macOS Sonoma), Gmail (web/Android/iOS), and Samsung Mail"]}]
41:["$","p","80",{"className":"text-[#BE8A83] leading-relaxed mb-4 text-base","children":["3. ",["$","strong","1",{"className":"font-bold text-[#FEF2F0]","children":"Accessibility audit"}],": Export an HTML copy and run axe or WAVE -- then manually verify with NVDA + Firefox or VoiceOver + Safari"]}]
